# SQLite path is relative to the backend working directory.
LUNISCAN_DATABASE_URL=sqlite:///./luniscan.db

# Authorize only laboratory networks you control. The default is loopback only.
LUNISCAN_APPROVED_SCOPE=["127.0.0.1","::1"]
LUNISCAN_APPROVED_SERVICE_PORT=8443
# Both discovery APIs use this maximum number of explicitly listed IPs (1 to 8).
LUNISCAN_DISCOVERY_LIMIT=4

# Certificate expiration thresholds in days. Critical cannot exceed warning.
LUNISCAN_TLS_WARN_DAYS=30
LUNISCAN_TLS_CRITICAL_DAYS=7
